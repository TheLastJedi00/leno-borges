# Secrets da Edge Function generate-ad (spec 013).
# Copie para supabase/functions/.env, preencha e envie com:
#   supabase secrets set --env-file supabase/functions/.env
# O .env nunca vai para o git.

# Google AI Studio > Get API key
GEMINI_API_KEY=

# Modelo de texto e nivel de raciocinio
GEMINI_MODEL=gemini-flash-latest
GEMINI_THINKING_LEVEL=medium

# Modelo de imagem (fundo opcional das pecas)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# UUID do usuario dono (Supabase > Authentication > Users)
OWNER_USER_ID=
